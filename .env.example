# Public base URL of this server, no trailing slash. Gateways send customers back to <PUBLIC_URL>/callback/<id>.
PUBLIC_URL=https://pay.example.com
# Bearer key for /v1/payments, at least 32 characters. Generate one: openssl rand -hex 32
API_KEY=replace-with-at-least-32-random-characters
# Where payment.status_changed webhooks are POSTed.
WEBHOOK_URL=https://shop.example.com/webhooks/payments
# HMAC-SHA256 key for the X-Checkout-Signature header. Generate one: openssl rand -hex 32
WEBHOOK_SECRET=replace-with-a-random-secret
# Where the customer lands after paying; payment_id and order_id are added to the query string.
RETURN_URL=https://shop.example.com/orders/done
# SQLite file (default checkout.db; the Docker image sets /data/checkout.db).
DB_PATH=checkout.db
# Address to listen on (default :8080).
LISTEN_ADDR=:8080
# eSewa merchant secret key; set together with ESEWA_PRODUCT_CODE to enable eSewa.
ESEWA_SECRET_KEY=
# eSewa product code (EPAYTEST in the sandbox).
ESEWA_PRODUCT_CODE=
# true to use the eSewa sandbox.
ESEWA_SANDBOX=true
# Khalti live or test secret key; set it to enable Khalti.
KHALTI_SECRET_KEY=
# true to use the Khalti sandbox.
KHALTI_SANDBOX=true
# true enables the mock gateway at /mock/. Anyone can mark its payments paid: never in production.
MOCK=false
